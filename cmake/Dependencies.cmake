foreach(dependency METAHOOK STEAMSDK GLEW GLFW)
    set(${dependency}_SOURCE_PATH "$ENV{${dependency}_SOURCE_PATH}" CACHE PATH "${dependency} source tree; empty fetches the pinned version")
endforeach()
set(CAPSTONE_INCLUDE_DIRS "$ENV{CAPSTONE_INCLUDE_DIRS}" CACHE STRING "External Capstone include directories; empty prefers the SDK's fork, then the pinned commit")

function(steamscreenshots_require_files name source)
    foreach(required IN LISTS ARGN)
        if(NOT EXISTS "${source}/${required}" OR IS_DIRECTORY "${source}/${required}")
            message(FATAL_ERROR "${name} is missing ${required}: ${source}")
        endif()
    endforeach()
endfunction()

# Populate only; GLEW and GLFW are configured separately with EXCLUDE_FROM_ALL.
function(steamscreenshots_fetch_source name url commit out_var)
    include(FetchContent)
    FetchContent_Declare(${name}
        GIT_REPOSITORY "${url}" GIT_TAG "${commit}"
        GIT_SUBMODULES "" GIT_SUBMODULES_RECURSE FALSE
        SOURCE_SUBDIR _steamscreenshots_source_only)
    FetchContent_MakeAvailable(${name})
    set(${out_var} "${${name}_SOURCE_DIR}" PARENT_SCOPE)
endfunction()

function(steamscreenshots_prepare_dependencies)
    set(METAHOOK_files include/metahook.h include/HLSDK/common/interface.cpp
        include/HLSDK/common/parsemsg.cpp include/HLSDK/common/cvardef.h include/Interface/IPlugins.h LICENSE)
    set(STEAMSDK_files steam/steam_api.h STEAM-SDK-NOTICE.md)
    set(GLEW_files CMakeLists.txt include/GL/glew.h src/glew.c LICENSE.txt)
    set(GLFW_files CMakeLists.txt include/GLFW/glfw3.h)
    set(dependencies METAHOOK STEAMSDK GLEW)
    if(BUILD_TESTING)
        list(APPEND dependencies GLFW)
    endif()

    # Explicit external trees are read-only inputs; reject invalid paths before downloading.
    foreach(dependency IN LISTS dependencies)
        if(${dependency}_SOURCE_PATH)
            get_filename_component(${dependency}_SOURCE_PATH "${${dependency}_SOURCE_PATH}" ABSOLUTE BASE_DIR "${PROJECT_SOURCE_DIR}")
            steamscreenshots_require_files("${dependency}_SOURCE_PATH" "${${dependency}_SOURCE_PATH}" ${${dependency}_files})
        endif()
    endforeach()

    set(capstone_includes)
    set(capstone_header_found FALSE)
    foreach(directory IN LISTS CAPSTONE_INCLUDE_DIRS)
        get_filename_component(directory "${directory}" ABSOLUTE BASE_DIR "${PROJECT_SOURCE_DIR}")
        if(NOT IS_DIRECTORY "${directory}")
            message(FATAL_ERROR "CAPSTONE_INCLUDE_DIRS directory does not exist: ${directory}")
        endif()
        if(EXISTS "${directory}/capstone.h")
            set(capstone_header_found TRUE)
        elseif(EXISTS "${directory}/capstone/capstone.h")
            string(APPEND directory "/capstone")
            set(capstone_header_found TRUE)
        endif()
        list(APPEND capstone_includes "${directory}")
    endforeach()
    if(CAPSTONE_INCLUDE_DIRS AND NOT capstone_header_found)
        message(FATAL_ERROR "CAPSTONE_INCLUDE_DIRS must provide capstone.h or capstone/capstone.h")
    endif()
    if(DEFINED CAPSTONE_LIBRARY_DIRS)
        message(STATUS "CAPSTONE_LIBRARY_DIRS is ignored: SteamScreenshots uses headers through the MetaHook API and does not link Capstone.")
    endif()

    set(METAHOOK_url https://github.com/MetaHookSv/MetaHook)
    # MetaHook is tracked as a branch: always fetch the latest main.
    set(METAHOOK_commit origin/main)
    set(STEAMSDK_url https://github.com/MetaHookSv/SteamSDK)
    set(STEAMSDK_commit 3c1abaf6277f9f99fd16ef40557d6852820b848f)
    set(GLEW_url https://github.com/hzqst/glew-cmake)
    set(GLEW_commit 459d9b95457c5db337e2742a5501c21faddda326)
    set(GLFW_url https://github.com/MetaHookSv/glfw)
    set(GLFW_commit 92dcf4ce74f2e2554a98fea09be7c705c17daa5a)
    foreach(dependency IN LISTS dependencies)
        if(NOT ${dependency}_SOURCE_PATH)
            string(TOLOWER "${dependency}" name)
            steamscreenshots_fetch_source(steamscreenshots_${name} "${${dependency}_url}" "${${dependency}_commit}" ${dependency}_SOURCE_PATH)
        endif()
        steamscreenshots_require_files("${dependency}_SOURCE_PATH" "${${dependency}_SOURCE_PATH}" ${${dependency}_files})
        set(${dependency}_SOURCE_PATH "${${dependency}_SOURCE_PATH}" PARENT_SCOPE)
        message(STATUS "${dependency}_SOURCE_PATH: ${${dependency}_SOURCE_PATH}")
    endforeach()

    if(NOT CAPSTONE_INCLUDE_DIRS)
        set(host_capstone "${METAHOOK_SOURCE_PATH}/thirdparty/capstone_fork/include/capstone")
        if(EXISTS "${host_capstone}/capstone.h")
            set(capstone_includes "${host_capstone}")
        else()
            steamscreenshots_fetch_source(steamscreenshots_capstone
                "https://github.com/hzqst/capstone"
                "9e27c51c2485dd37dd3917919ae781c6153f3688" capstone_source)
            set(capstone_includes "${capstone_source}/include/capstone")
        endif()
    endif()
    set(STEAMSCREENSHOTS_CAPSTONE_INCLUDE_DIRS "${capstone_includes}" PARENT_SCOPE)
    message(STATUS "Capstone headers: ${capstone_includes}")
endfunction()
